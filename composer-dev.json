{
  "name": "boctulus/simplerest-monorepo-dev",
  "type": "project",
  "description": "Development tools and tests for the SimpleRest microcore monorepo",
  "license": "MIT",
  "require": {
    "php": ">=8.1,<8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Boctulus\\Simplerest\\Core\\": "src/framework/"
    }
  },
  "scripts": {
    "test:microcore": "phpunit --no-coverage unit-tests/microcore"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
