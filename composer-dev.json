{
  "name": "boctulus/simplerest-monorepo-dev",
  "type": "project",
  "description": "Development tools and tests for the SimpleRest microcore monorepo",
  "license": "MIT",
  "require": {
    "php": ">=8.1,<8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Boctulus\\Simplerest\\Core\\": "src/framework/",
      "Boctulus\\Simplerest\\": [
        "app/",
        "src/"
      ],
      "Boctulus\\FineGrainedACL\\": "packages/boctulus/simplerest-fine-grained-acl/src/",
      "Boctulus\\LLMProviders\\": "packages/boctulus/simplerest-llm-providers/src/"
    },
    "classmap": [
      "packages/boctulus/simplerest-scaffolding/src/",
      "packages/boctulus/simplerest-api-clients/src/",
      "packages/boctulus/simplerest-i18n/src/",
      "packages/boctulus/simplerest-html-generation/src/",
      "packages/boctulus/simplerest-jobs/src/",
      "packages/boctulus/simplerest-geolocation/src/",
      "packages/boctulus/simplerest-gd-image/src/",
      "packages/boctulus/simplerest-string-obfuscation/src/",
      "packages/boctulus/simplerest-machine-id/src/",
      "packages/boctulus/simplerest-sse/src/",
      "packages/boctulus/simplerest-psr7/src/",
      "packages/boctulus/simplerest-mail/src/",
      "packages/boctulus/simplerest-jwt-auth/src/"
    ],
    "files": [
      "packages/boctulus/simplerest-i18n/src/helpers.php",
      "packages/boctulus/simplerest-psr7/src/helpers.php"
    ],
    "exclude-from-classmap": [
      "src/framework/Templates/"
    ]
  },
  "scripts": {
    "test:microcore": "phpunit --no-coverage unit-tests/microcore"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
