{
  "name": "boctulus/simplerest",
  "type": "library",
  "description": "Minimal PHP HTTP core for SimpleRest applications",
  "keywords": [
    "simplerest",
    "php",
    "http",
    "router",
    "framework"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pablo Gabriel Bozzolo",
      "email": "boctulus@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1,<8.5"
  },
  "autoload": {
    "psr-4": {
      "Boctulus\\Simplerest\\Core\\": "src/framework/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "3.0.x-dev"
    }
  },
  "config": {
    "optimize-autoloader": true
  }
}
