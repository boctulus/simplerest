{
	"name":"boctulus/simplerest",
   "type":"library",
   "description":"API Rest framework for PHP",
   "keywords":[
      "simplerest",
      "framework",
      "boctulus"
   ],
   "license":"MIT",
   "authors":[
      {
         "name":"Pablo Gabriel Bozzolo",
         "email":"boctulus@gmail.com"
      }
   ],
   "require":{
      "php":">=8.1,<8.5",
		"doctrine/inflector": "^2.0",
		"psr/http-message": "^2.0",
		"firebase/php-jwt": "^7.1",
		"symfony/dom-crawler": "^6.4",
		"symfony/css-selector": "^6.4"
   },
	"require-dev": {
      "phpunit/phpunit": "^10.0",
	  "phpstan/phpstan": "^1.10",
	  "vlucas/phpdotenv": "^5.2",
	  "phpmailer/phpmailer": "^7.1",
	  "setasign/fpdf": "^1.8",
	  "nikic/php-parser": "^5.4"
	},
	"suggest": {
	  "phpmailer/phpmailer": "Optional SMTP adapter for Core\\Libs\\Mail; supports PHPMailer 6.9 and 7.1.",
	  "google/apiclient": "Optional Google Drive integration for Core\\Libs\\GoogleDrive.",
	  "guzzlehttp/guzzle": "Optional HTTP client used by Google Drive and the bundled SendinBlue adapter.",
	  "boctulus/simplerest-pdf": "Optional PDF base class and FPDF integration.",
	  "boctulus/simplerest-code-tools": "Optional PHP source tools and make commands."
	},
   "scripts":{
      "test": "phpunit --colors=always unit-tests",
      "cs": "phpstan analyse src --level=7"
   },
   "extra":{
      "google/apiclient-services":[
         "Drive"
      ]
   },
   "autoload":{
      "psr-4":{
         "Boctulus\\Simplerest\\Core\\":"src/framework/"
      },
      "exclude-from-classmap": [
         "src/framework/Templates/"
      ]
   },
   "autoload-dev": {
      "psr-4": {
         "Boctulus\\Simplerest\\Tests\\": "unit-tests/",
         "Boctulus\\Simplerest\\": ["app/", "src/"],
         "Boctulus\\Simplerest\\Core\\Libs\\":["src/framework/Libs/", "packages/boctulus/simplerest-pdf/src/", "packages/boctulus/simplerest-code-tools/src/"],
         "Boctulus\\FineGrainedACL\\":"packages/boctulus/fine-grained-acl/src",
         "Boctulus\\BasicACL\\":"packages/boctulus/basic-acl/src",
         "Boctulus\\CliTest\\":"packages/boctulus/cli-test/src",
         "Boctulus\\WebTest\\":"packages/boctulus/web-test/src",
         "Boctulus\\LLMProviders\\": "packages/boctulus/llm-providers/src",
         "Boctulus\\AzSeeder\\": "packages/boctulus/az-seeder/src"
      },
      "classmap": [
         "packages/boctulus/simplerest-code-tools/src/Commands/"
      ]
   },
   "config":{
      "optimize-autoloader":true,
      "allow-plugins":{
         "php-http/discovery":true
      },      
      "preferred-install": {
        "boctulus/api-client": "dist",
        "boctulus/shopifyconnector": "dist"
      }
   },
   "minimum-stability":"stable",
   "prefer-stable":true
}
