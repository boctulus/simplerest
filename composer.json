{
  "name": "boctulus/simplerest",
  "type": "library",
  "description": "Lightweight PHP REST framework core. Specific libraries are distributed as separate packages.",
  "keywords": [
    "simplerest",
    "php",
    "http",
    "router",
    "framework"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pablo Gabriel Bozzolo",
      "email": "boctulus@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1,<8.5",
    "doctrine/inflector": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Boctulus\\Simplerest\\Core\\": "src/framework/"
    },
    "exclude-from-classmap": [
      "src/framework/Templates/"
    ]
  },
  "version": "3.0.2",
  "extra": {
    "branch-alias": {
      "dev-master": "3.0.x-dev"
    }
  },
  "scripts": {
    "post-root-package-install": "@php scripts/composer/create-project.php"
  },
  "config": {
    "optimize-autoloader": true
  }
}
