{
    "name": "boctulus/zippy",
    "description": "Package zippy by boctulus",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Boctulus\\Zippy\\": "src/"
        }
    },
    "extra": {
        "simplerest": {
            "providers": [
                "Boctulus\\Zippy\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": ">=8.1,<8.5",
        "boctulus/simplerest": "^2.0"
    },
    "suggest": {
        "boctulus/llm-providers": "Optional LLM matching strategy; not registered on Packagist and unavailable for independent installation yet."
    }
}
