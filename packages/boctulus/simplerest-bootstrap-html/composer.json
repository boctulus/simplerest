{
    "name": "boctulus/simplerest-bootstrap-html",
    "description": "Bootstrap 5 and AdminLTE HTML builders and pagination for SimpleRest",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1,<8.5",
        "boctulus/simplerest": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Boctulus\\Simplerest\\HtmlBuilders\\": "src/",
            "Boctulus\\Simplerest\\Integrations\\Libs\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit --do-not-cache-result"
    }
}
