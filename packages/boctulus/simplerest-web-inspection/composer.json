{
    "name": "boctulus/simplerest-web-inspection",
    "description": "CMS and technology detection plus HTML selector helpers for SimpleRest",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1,<8.5",
        "ext-curl": "*",
        "boctulus/simplerest": "^2.0 || ^3.0",
        "symfony/css-selector": "^6.4",
        "symfony/dom-crawler": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit --do-not-cache-result"
    },
    "autoload": {
        "psr-4": {
            "Boctulus\\Simplerest\\Integrations\\": "src/"
        }
    }
}
