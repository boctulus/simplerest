{
    "name": "boctulus/simplerest-phpparser",
    "description": "AST-based PHP source transforms for SimpleRest applications",
    "type": "library",
    "license": "MIT",
    "keywords": ["simplerest", "php", "parser", "ast"],
    "authors": [
        {
            "name": "Pablo Gabriel Bozzolo",
            "email": "boctulus@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1,<8.5",
        "nikic/php-parser": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": [
            "src/PHPParser.php"
        ]
    },
    "scripts": {
        "test": "phpunit --do-not-cache-result"
    }
}
