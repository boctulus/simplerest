{
    "name": "boctulus/simplerest-scaffolding",
    "description": "Code generators and PHP development tools for SimpleRest applications",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1,<8.5",
        "boctulus/simplerest": "^2.0 || ^3.0",
        "nikic/php-parser": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit --do-not-cache-result"
    },
    "autoload": {
        "psr-4": {
            "Boctulus\\Simplerest\\Core\\Libs\\": "src/",
            "Boctulus\\Simplerest\\CodeTools\\Cleaners\\": "src/Cleaners/"
        },
        "classmap": [
            "src/Commands/"
        ]
    }
}
