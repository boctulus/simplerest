{
    "name": "boctulus/simplerest-scaffolding",
    "description": "Command-line project scaffolding tools for SimpleRest applications",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1,<8.5",
        "boctulus/simplerest": "^2.0 || ^3.0",
        "boctulus/simplerest-i18n": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit --do-not-cache-result"
    },
    "autoload": {
        "classmap": ["src/"]
    }
}
