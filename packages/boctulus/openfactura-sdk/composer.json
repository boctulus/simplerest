{
    "name": "boctulus/openfactura-sdk",
    "description": "Package openfactura-sdk by boctulus",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Boctulus\\OpenfacturaSdk\\": "src/"
        }
    },
    "extra": {
        "simplerest": {
            "providers": [
                "Boctulus\\OpenfacturaSdk\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": ">=8.1,<8.5",
        "boctulus/simplerest": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    }
}
