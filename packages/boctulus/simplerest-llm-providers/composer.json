{
    "name": "boctulus/simplerest-llm-providers",
    "description": "Unified interface for OpenAI, Anthropic, xAI, and Ollama LLM providers",
    "type": "library",
    "keywords": ["llm", "openai", "chatgpt", "claude", "anthropic", "xai", "ollama", "ai", "machine-learning"],
    "license": "MIT",
    "authors": [
        {
            "name": "boctulus",
            "email": "boctulus@example.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Boctulus\\LLMProviders\\": "src/"
        }
    },
    "extra": {
        "simplerest": {
            "providers": [
                "Boctulus\\LLMProviders\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": ">=8.1,<8.5",
        "boctulus/simplerest": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "phpunit --do-not-cache-result"
    }
}
